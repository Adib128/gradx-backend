generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  LECTURE
  SLIDES
  QUIZ
  LAB
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  CODING
  MATH
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum AssessmentType {
  QUIZ
  EXAM
  LAB
  OTHER
}

enum Language {
  ENGLISH
  ARABIC
}

enum UserRole {
  USER
  ADMIN
}

model Tenant {
  id            Int            @id @default(autoincrement())
  createdAt     DateTime       @default(now())
  users         User[]
  departements  Departement[]
  classes       Class[]
  students      Student[]
  courses       Course[]
  topicContents TopicContent[]
  questions     Question[]
  assessments   Assessment[]

  @@map("tenants")
}

model User {
  id                        Int       @id @default(autoincrement())
  email                     String    @unique
  phone                     String?   @unique
  passwordHash              String
  hashVersion               String
  firstName                 String?
  lastName                  String?
  universityName            String?
  fieldName                 String?
  tenantId                  Int
  role                      UserRole  @default(USER)
  isVerified                Boolean   @default(true)
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  isActive                  Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  lastLogin                 DateTime?
  tenant                    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([email])
  @@map("users")
}

model Departement {
  id   Int    @id @default(autoincrement())
  name String @unique

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  classes   Class[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("departements")
}

model Class {
  id            Int         @id @default(autoincrement())
  name          String      @unique
  departementId Int
  departement   Departement @relation(fields: [departementId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]

  @@index([tenantId])
  @@map("classes")
}

model Student {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  classId Int
  class   Class @relation(fields: [classId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@map("students")
}

model Course {
  id Int @id @default(autoincrement())

  title             String
  code              String?
  program           String?
  description       String?
  creditHours       Int?
  level             String?
  teachingMode      String?
  totalContactHours Int?
  lectureHours      Int?
  labHours          Int?
  prerequisites     String[]
  references        Json?

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  topics Topic[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  topicContents TopicContent[]
  questions     Question[]
  assessments   Assessment[]
  clos          Clo[]

  @@index([tenantId])
  @@map("courses")
}

model Topic {
  id           Int    @id @default(autoincrement())
  topicNumber  Int
  title        String
  contactHours Int    @default(3)

  courseId         Int
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topicContents    TopicContent[]
  questions        Question[]
  assessmentTopics AssessmentTopic[]

  @@unique([courseId, topicNumber])
  @@index([courseId])
  @@map("topics")
}

model Clo {
  id Int @id @default(autoincrement())

  code               String
  category           String
  programCLOCode     String?
  description        String
  teachingStrategies String[]
  assessmentMethods  String[]

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  @@unique([code])
  @@index([courseId])
  @@map("clos")
}

model TopicContent {
  id      Int              @id @default(autoincrement())
  type    ContentType
  status  GenerationStatus @default(PENDING)
  content Json?

  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([topicId, type])
  @@index([topicId])
  @@index([tenantId])
  @@map("topic_contents")
}

model Question {
  id             Int             @id @default(autoincrement())
  type           QuestionType
  diffdifficulty DifficultyLevel @default(EASY)
  text           String
  explanation    String?
  points         Int             @default(1)

  correctAnswer  String?
  codeTemplate   String?
  codeLanguage   String?
  expectedOutput String?
  mathFormula    String?
  mathSolution   String?

  questionOptions QuestionOption[]

  courseId Int?
  course   Course? @relation(fields: [courseId], references: [id])

  topicId Int?
  topic   Topic? @relation(fields: [topicId], references: [id])

  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId])
  @@index([courseId])
  @@index([tenantId])
  @@map("questions")
}

model QuestionOption {
  id Int @id @default(autoincrement())

  text      String
  isCorrect Boolean @default(false)
  order     Int

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model Assessment {
  id          Int            @id @default(autoincrement())
  type        AssessmentType
  title       String
  duration    Int?
  totalPoints Int?
  passMark    Int?
  language    Language?
  isPublished Boolean        @default(true)
  timing      String?
  score       Int?

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  questions        Question[]
  assessmentTopics AssessmentTopic[]

  @@index([courseId])
  @@index([tenantId])
  @@index([type])
  @@map("assessments")
}

model AssessmentTopic {
  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id])

  @@id([assessmentId, topicId])
  @@map("assessment_topic")
}
