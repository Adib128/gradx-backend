generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  LECTURE
  SLIDES
  QUIZ
  LAB
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  CODING
  MATH
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum AssessmentType {
  QUIZ
  FINAL_EXAM
  MID_TERM_EXAM
  LAB
  OTHER
}

enum Language {
  ENGLISH
  ARABIC
}

enum UserRole {
  USER
  ADMIN
}

enum Bloom {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum DifficultyDistribution {
  BEGINNER
  EASY
  BALANCED
  MIXED
  ADVANCED
  EXPERT
}

enum AssessmentPaperSize {
  LETTER
  A3
  A4
  A5
  A6
}

enum AssessmentAnswerSheetMode {
  APPEND_SEPARATE_PDF
  APPEND_SAME_PDF
  NONE
}

enum AssessmentStudentIdLabel {
  STUDENT_ID
  STUDENT_NAME
}

enum GradingScanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Tenant {
  id            Int            @id @default(autoincrement())
  createdAt     DateTime       @default(now())
  users         User[]
  departements  Departement[]
  classes       Class[]
  courses       Course[]
  topicContents TopicContent[]
  questions     Question[]
  assessments   Assessment[]
  gradingScans  GradingScan[]

  @@map("tenants")
}

model User {
  id                        Int       @id @default(autoincrement())
  email                     String    @unique
  phone                     String?   @unique
  passwordHash              String
  hashVersion               String
  firstName                 String?
  lastName                  String?
  universityName            String?
  fieldName                 String?
  tenantId                  Int
  role                      UserRole  @default(USER)
  isVerified                Boolean   @default(true)
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  isActive                  Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  lastLogin                 DateTime?
  tenant                    Tenant    @relation(fields: [tenantId], references: [id])
  gradingScans              GradingScan[]

  @@index([email])
  @@map("users")
}

model Departement {
  id   Int    @id @default(autoincrement())
  name String @unique

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  classes   Class[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("departements")
}

model Class {
  id            Int         @id @default(autoincrement())
  name          String      @unique
  departementId Int
  departement   Departement @relation(fields: [departementId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("classes")
}

model Student {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique
  class       String?
  departement String?

  courseId Int?
  course   Course? @relation(fields: [courseId], references: [id])

  gradingScans GradingScan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@map("students")
}

model Course {
  id Int @id @default(autoincrement())

  title             String
  code              String?
  program           String?
  description       String?
  creditHours       Int?
  level             String?
  teachingMode      String?
  teachingModes     Json?
  totalContactHours Int?
  lectureHours      Int?
  labHours          Int?
  prerequisites     String[]
  coRequisites      String[] @default([])
  requiredFacilitiesAndEquipment Json?
  references        Json?

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  topics Topic[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  topicContents TopicContent[]
  questions     Question[]
  assessments   Assessment[]
  clos          Clo[]
  students      Student[]

  @@index([tenantId])
  @@map("courses")
}

model Topic {
  id           Int    @id @default(autoincrement())
  topicNumber  Int
  title        String
  contactHours Int    @default(3)

  courseId         Int
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topicContents    TopicContent[]
  questions        Question[]
  assessmentTopics AssessmentTopic[]
  topicClos        TopicClo[]

  @@unique([courseId, topicNumber])
  @@index([courseId])
  @@map("topics")
}

model Clo {
  id Int @id @default(autoincrement())

  code               String
  category           String
  programCLOCode     String?
  description        String
  teachingStrategies String[]
  assessmentMethods  String[]

  courseId     Int?
  course       Course?       @relation(fields: [courseId], references: [id])
  questionClos QuestionClo[]
  topicClos    TopicClo[]

  @@index([courseId])
  @@map("clos")
}

model TopicContent {
  id      Int              @id @default(autoincrement())
  type    ContentType
  status  GenerationStatus @default(PENDING)
  content Json?

  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([topicId, type])
  @@index([topicId])
  @@index([tenantId])
  @@map("topic_contents")
}

model Question {
  id          Int          @id @default(autoincrement())
  type        QuestionType
  text        String
  bloom       Bloom?
  explanation String?
  points      Int          @default(1)

  correctAnswer  String?
  codeTemplate   String?
  codeLanguage   String?
  expectedOutput String?
  mathFormula    String?
  mathSolution   String?

  questionOptions QuestionOption[]

  topicId Int?
  topic   Topic? @relation(fields: [topicId], references: [id])

  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  questionClos               QuestionClo[]
  course                     Course?                     @relation(fields: [courseId], references: [id])
  courseId                   Int?
  assessmentVersionQuestions AssessmentVersionQuestion[]

  @@index([topicId])
  @@index([tenantId])
  @@map("questions")
}

model QuestionOption {
  id Int @id @default(autoincrement())

  text      String
  isCorrect Boolean @default(false)
  order     Int

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model QuestionClo {
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])

  cloId Int
  Clo   Clo @relation(fields: [cloId], references: [id])

  @@id([questionId, cloId])
  @@map("question_clos")
}

model Assessment {
  id                                      Int                       @id @default(autoincrement())
  type                                    AssessmentType
  title                                   String
  duration                                Int?
  totalMarks                              Int?
  passMark                                Int?
  language                                Language?
  difficulty                              DifficultyDistribution?
  isPublished                             Boolean                   @default(true)
  numberOfVersions                        Int                       @default(2)
  paperSize                               AssessmentPaperSize       @default(A4)
  answerSheetMode                         AssessmentAnswerSheetMode @default(APPEND_SAME_PDF)
  showMarksPerQuestion                    Boolean                   @default(false)
  includeStudentInfoHeader                Boolean                   @default(false)
  studentIdLabel                          AssessmentStudentIdLabel  @default(STUDENT_ID)
  numberOfStudentIdDigits                 Int                       @default(3)
  includeAssessmentInstructionsSection    Boolean                   @default(false)
  assessmentInstructions                  String?
  printCloCodeNextToEachQuestion          Boolean                   @default(false)
  printBloomLevelNextToEachQuestion       Boolean                   @default(false)
  printDifficultyLabelNextToEachQuestion  Boolean                   @default(false)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  questions          Question[]
  assessmentTopics   AssessmentTopic[]
  assessmentVersions AssessmentVersion[]
  gradingScans       GradingScan[]

  @@index([courseId])
  @@index([tenantId])
  @@index([type])
  @@map("assessments")
}

model GradingScan {
  id               Int               @id @default(autoincrement())
  assessmentId     Int
  assessment       Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  tenantId         Int
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  graderUserId     Int
  graderUser       User              @relation(fields: [graderUserId], references: [id])
  status           GradingScanStatus @default(PENDING)
  imagePath        String?
  decodedFormId    Int?
  confidence       Float?
  detectedAnswers  Json?
  questionDetails  Json?
  score            Float?
  maxScore         Float?
  errorMessage     String?
  /// Student ID detected from the bubble grid (e.g. "12345")
  detectedStudentId String?
  /// Matched student code from the students table (may be null if student not found)
  matchedStudentCode String?
  /// Direct FK to Student record — set when the teacher confirms the result
  studentId        Int?
  student          Student?          @relation(fields: [studentId], references: [id])
  /// Timestamp when the teacher confirmed and saved the result
  confirmedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([assessmentId])
  @@index([tenantId])
  @@index([graderUserId])
  @@index([detectedStudentId])
  @@index([studentId])
  @@map("grading_scans")
}

model AssessmentVersion {
  id          Int    @id @default(autoincrement())
  versionName String

  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  versionQuestions AssessmentVersionQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@map("assessment_versions")
}

model AssessmentVersionQuestion {
  id Int @id @default(autoincrement())

  assessmentVersionId Int
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id], onDelete: Cascade)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  order Int

  @@unique([assessmentVersionId, questionId])
  @@index([assessmentVersionId])
  @@index([questionId])
  @@map("assessment_version_questions")
}

model AssessmentTopic {
  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id])

  @@id([assessmentId, topicId])
  @@map("assessment_topic")
}

model TopicClo {
  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id])

  cloId Int
  clo   Clo @relation(fields: [cloId], references: [id])

  @@id([topicId, cloId])
  @@map("topic_clos")
}
