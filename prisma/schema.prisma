generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id           Int           @id @default(autoincrement())
  createdAt    DateTime      @default(now())
  users        User[]
  departements Departement[]
  classes      Class[]
  students     Student[]
  courses      Course[]

  @@map("tenants")
}

model User {
  id                        Int       @id @default(autoincrement())
  email                     String    @unique
  phone                     String?   @unique
  passwordHash              String
  hashVersion               String
  firstName                 String?
  lastName                  String?
  universityName            String?
  fieldName                 String?
  tenantId                  Int
  role                      UserRole  @default(USER)
  isVerified                Boolean   @default(true)
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  isActive                  Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  lastLogin                 DateTime?
  tenant                    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([email])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Departement {
  id   Int    @id @default(autoincrement())
  name String @unique

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  classes   Class[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("departements")
}

model Class {
  id            Int         @id @default(autoincrement())
  name          String      @unique
  departementId Int
  departement   Departement @relation(fields: [departementId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]

  @@index([tenantId])
  @@map("classes")
}

model Student {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  classId Int
  class   Class @relation(fields: [classId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@map("students")
}

model Course {
  id Int @id @default(autoincrement())

  title             String
  code              String?
  program           String?
  description       String?
  creditHours       Int?
  level             String?
  teachingMode      String?
  totalContactHours Int?
  lectureHours      Int?
  labHours          Int?
  prerequisites     String[]
  references        Json?
  assessments       Json?

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  topics Topic[]

  clos CLO[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("courses")
}

model Topic {
  id           Int    @id @default(autoincrement())
  topicNumber  Int
  title        String
  contactHours Int    @default(3)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, topicNumber])
  @@index([courseId])
  @@map("topics")
}

model CLO {
  id Int @id @default(autoincrement())

  code               String
  category           String
  programCLOCode     String?
  description        String
  teachingStrategies String[]
  assessmentMethods  String[]

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, code])
  @@index([courseId])
  @@map("clos")
}
